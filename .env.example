# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://postgres@localhost:5432/hawala_db?schema=public"

# Redis cache & queue host configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"

# Security & Authentication (REQUIRED - Fail-fast on startup if missing)
JWT_SECRET="replace-with-a-secure-random-256-bit-string-in-production"

# Global rate limiting configuration
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Application Port
PORT=3000
